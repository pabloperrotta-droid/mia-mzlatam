rules_version = '2';
// Reglas de seguridad de la base de MIA (Firestore, proyecto mzlatam-app). Sección 129.
// Solo leen/escriben los mails confirmados que estén en la lista de usuarios y activos:
//   Producción → colección `usuarios`; QA → `qa_usuarios` (cada ambiente con su lista).
// La lista de usuarios solo la maneja un Admin; cada persona puede leer solo su propia ficha.
// Los procesos de GitHub (Xubio, respaldo) usan la cuenta de servicio y no pasan por estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {
    function confirmado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function miMail() {
      return request.auth.token.email.lower();
    }
    function prefijo(coleccion) {
      return coleccion.matches('qa_.*') ? 'qa_' : '';
    }
    function ficha(p) {
      return /databases/$(database)/documents/$(p + 'usuarios')/$(miMail());
    }
    function habilitado(p) {
      return confirmado() && exists(ficha(p)) && get(ficha(p)).data.get('activo', true) != false;
    }
    function esAdmin(p) {
      return habilitado(p) && get(ficha(p)).data.get('rol', '') == 'admin';
    }

    match /usuarios/{email} {
      allow get: if confirmado() && email == miMail();
      allow read, write: if esAdmin('');
    }
    match /qa_usuarios/{email} {
      allow get: if confirmado() && email == miMail();
      allow read, write: if esAdmin('qa_');
    }
    match /{coleccion}/{resto=**} {
      allow read, write: if !coleccion.matches('(qa_)?usuarios') && habilitado(prefijo(coleccion));
    }
  }
}
